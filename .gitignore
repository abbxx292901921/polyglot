# Polyglot — never commit secrets or personal backups
*.vault.json
backups/
.vault.json

# Exported minigames: agent-authored documents. They are not source, and a
# shared one must never be able to report the reader's address to whoever
# wrote it. Export them from the app, share them as files, not as repo content.
polyglot-*.html
polyglot-*.json
polyglot-*.txt
minigame-*.html

